        "sql": "SELECT ticker, count(*) AS minute_rows, sum(v) AS volume,\nmin(t) AS first_t, max(t) AS last_t, min(l) AS low, max(h) AS high\nFROM input1 GROUP BY ticker ORDER BY ALL"
