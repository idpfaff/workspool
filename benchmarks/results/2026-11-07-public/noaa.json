    "steps": [
      {
        "name": "elements",
        "inputs": [
          "observations"
        ],
        "sql": "SELECT element, count(*) AS records, count(value) AS populated, sum(value) AS total_value, min(value) AS min_value, max(value) AS max_value FROM input1 GROUP BY element ORDER BY ALL",
        "oracle": {
          "source": "observations",
          "group_by": [
            "element"
          ],
          "aggregates": [
            {
              "name": "records",
              "op": "count_rows"
            },
            {
              "name": "populated",
              "op": "count",
              "column": "value"
            },
            {
              "name": "total_value",
              "op": "sum",
              "column": "value"
            },
            {
              "name": "min_value",
              "op": "min",
              "column": "value"
            },
            {
              "name": "max_value",
              "op": "max",
              "column": "value"
            }
          ],
          "sort": [
            {
              "column": "element"
            }
          ]
        }
      },
      {
        "name": "largest_elements",
        "inputs": [
          "elements"
        ],
        "sql": "SELECT element, records, populated, total_value, min_value, max_value FROM input1 ORDER BY records DESC, element, populated, total_value, min_value, max_value LIMIT 5",
        "oracle": {
          "source": "elements",
          "columns": [
            "element",
