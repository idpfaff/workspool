            },
            {
              "column": "max_value"
            }
          ],
          "limit": 5
        }
      },
      {
        "name": "quality_flags",
        "inputs": [
          "fixed_subset"
        ],
        "sql": "SELECT qflag, count(*) AS records, min(date) AS first_date, max(date) AS last_date FROM input1 GROUP BY qflag ORDER BY ALL",
        "oracle": {
          "source": "fixed_subset",
          "group_by": [
